let activeQuiz = null;     // { quizId, questions, answers, startedAt, timeLimitSeconds, expiresAt }
let quizTimerHandle = null;

function startQuiz() {
    const user = currentUser();
    if (!user) return;

    const catId = document.getElementById("qcat").value;
    const diff  = document.getElementById("qdiff").value;
    const num   = Math.max(1, Math.min(15, Number(document.getElementById("qnum").value) || 5));

    let pool = DB.questions;
    if (catId) pool = pool.filter(q => q.categoryId === Number(catId));
    if (diff)  pool = pool.filter(q => q.difficulty === diff);

    if (pool.length === 0) {
        alert("No questions match that filter. Try a wider selection.");
        return;
    }

    const chosen = shuffle(pool).slice(0, Math.min(num, pool.length));
    const timeLimitSeconds = chosen.length * 60;

    const quizId = uid();
    const quiz = {
        quizId,
        userId: user.userId,
        startedAt: new Date().toISOString(),
        submittedAt: null,
        status: "IN_PROGRESS",
        timeLimitSeconds,
        questionIds: chosen.map(q => q.questionId)
    };
    DB.quizzes.push(quiz);

    activeQuiz = {
        quizId,
        questions: chosen,
        answers: {},
        startedAt: Date.now(),
        timeLimitSeconds,
        expiresAt: Date.now() + timeLimitSeconds * 1000
    };

    persist();
    navigate("quiz");
}

/* ---------- Quiz Runner ---------- */
function viewQuiz() {
    if (!activeQuiz) { navigate("quiz-setup"); return ""; }
    const { questions, answers } = activeQuiz;

    return `
        ${navbar()}
        <div class="container">
            <div class="flex between center mb-3">
                <h2 style="margin:0">Quiz #${activeQuiz.quizId}</h2>
                <div id="timerBox" class="timer">--:--</div>
            </div>

            ${questions.map((q, i) => `
                <div class="card mb-3">
                    <div class="flex between center mb-2">
                        <span class="badge">${escapeHtml(categoryById(q.categoryId)?.name || "")}</span>
                        <span class="difficulty-${q.difficulty}">${q.difficulty}</span>
                    </div>
                    <div class="fw-bold mb-3">${i + 1}. ${escapeHtml(q.text)}</div>
                    ${["A","B","C","D"].map(o => `
                        <div class="question-option ${answers[q.questionId] === o ? "selected" : ""}"
                             onclick="selectAnswer(${q.questionId}, '${o}')">
                            <b>${o}.</b> ${escapeHtml(q["option" + o])}
                        </div>
                    `).join("")}
                </div>
            `).join("")}

            <button class="btn btn-success btn-block mt-2" onclick="submitQuiz()">
                Submit Quiz
            </button>
        </div>
    `;
}

function selectAnswer(questionId, option) {
    if (!activeQuiz) return;
    activeQuiz.answers[questionId] = option;
    persist();

    // Update only the affected card's option highlights
    document.querySelectorAll(".question-option").forEach(el => {
        // Not perfectly scoped, but fine for this demo — re-render is simpler
    });
    // Simple full re-render for reliability
    render();
}

function afterQuizRender() {
    if (!activeQuiz) return;
    updateTimer();
    if (quizTimerHandle) clearInterval(quizTimerHandle);
    quizTimerHandle = setInterval(() => {
        updateTimer();
        if (Date.now() >= activeQuiz.expiresAt) {
            clearInterval(quizTimerHandle);
            submitQuiz(true);
        }
    }, 1000);
}

function updateTimer() {
    const box = document.getElementById("timerBox");
    if (!box || !activeQuiz) return;
    const remainMs = Math.max(0, activeQuiz.expiresAt - Date.now());
    const total = Math.floor(remainMs / 1000);
    const m = String(Math.floor(total / 60)).padStart(2, "0");
    const s = String(total % 60).padStart(2, "0");
    box.textContent = `⏱ ${m}:${s}`;
    box.classList.toggle("danger", total <= 30);
}

function submitQuiz(auto = false) {
    if (!activeQuiz) return;

    if (!auto) {
        const unanswered = activeQuiz.questions.length - Object.keys(activeQuiz.answers).length;
        if (unanswered > 0 && !confirm(`${unanswered} question(s) unanswered. Submit anyway?`)) {
            return;
        }
    }

    if (quizTimerHandle) clearInterval(quizTimerHandle);

    const quiz = DB.quizzes.find(q => q.quizId === activeQuiz.quizId);
    let correct = 0;

    activeQuiz.questions.forEach(q => {
        const selected = activeQuiz.answers[q.questionId] || null;
        const isCorrect = selected === q.correctOption;
        if (isCorrect) correct++;

        DB.userAnswers.push({
            quizId: activeQuiz.quizId,
            questionId: q.questionId,
            selected,
            isCorrect
        });
    });

    const total = activeQuiz.questions.length;
    const score = Math.round((correct / total) * 100);

    quiz.submittedAt = new Date().toISOString();
    quiz.status = "COMPLETED";

    DB.quizResults.push({
        quizId: quiz.quizId,
        score, total, correct
    });

    const finishedId = activeQuiz.quizId;
    activeQuiz = null;
    persist();

    navigate("result", { quizId: finishedId });
}

