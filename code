    const box = document.getElementById("ai-" + questionId);
    box.innerHTML = `<div class="text-muted small">AI is thinking…</div>`;

    setTimeout(() => {
        const r = AI.explain(q, selected);
        AI.logExplain(user.userId, questionId, selected, r);

        box.innerHTML = `
            <div class="alert alert-info">
                <div class="mb-2"><span class="ai-badge">AI Explanation</span></div>
                <p class="mb-2"><b>Mistake:</b> ${escapeHtml(r.mistake)}</p>
                <p class="mb-2"><b>Correct answer:</b> ${escapeHtml(r.correctAnswer)}</p>
                <div class="mb-2"><b>Steps:</b>
                    <ol class="mb-0" style="padding-left:20px">
