            return;
        }
        if (pw !== cf) {
            err.textContent = "Passwords do not match.";
            err.classList.remove("hidden");
            return;
        }
        if (DB.users.some(u => u.email.toLowerCase() === email)) {
            err.textContent = "That email is already registered.";
            err.classList.remove("hidden");
            return;
        }

        const user = {
