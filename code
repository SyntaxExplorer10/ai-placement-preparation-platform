<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>AI Placement Preparation Platform</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
/* ============================================================
   Design tokens
   ============================================================ */
:root {
  --primary:       #4f46e5;
  --primary-dark:  #4338ca;
  --primary-light: #eef2ff;
  --admin:         #111827;
  --bg:            #f7f8fa;
  --text:          #1f2937;
  --muted:         #6b7280;
  --border:        #e5e7eb;
  --success:       #16a34a;
  --danger:        #dc2626;
  --warning:       #d97706;
  --radius:        12px;
  --shadow:        0 2px 12px rgba(0,0,0,.06);
  --shadow-hover:  0 6px 20px rgba(79,70,229,.15);
}

* { box-sizing: border-box; }

html, body { height: 100%; }

body {
  background: var(--bg);
  color: var(--text);
  font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  font-size: 15px;
  line-height: 1.5;
  margin: 0;
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
}

a { color: var(--primary); text-decoration: none; }
a:hover { color: var(--primary-dark); }

h1, h2, h3, h4, h5 { font-weight: 700; margin-top: 0; }

/* ---------- Layout ---------- */
.container {
  max-width: 1100px;
  margin: 0 auto;
  padding: 24px 16px 80px;
}

.row { display: flex; flex-wrap: wrap; gap: 16px; }
.col { flex: 1 1 200px; min-width: 0; }

/* ---------- Navbar ---------- */
.navbar {
  background: var(--primary);
  color: #fff;
  box-shadow: 0 1px 6px rgba(0,0,0,.08);
  padding: 12px 0;
}
.navbar.admin { background: var(--admin); }
.navbar .container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 0;
  padding-bottom: 0;
}
.navbar-brand {
  color: #fff;
  font-weight: 700;
  font-size: 1.15rem;
  letter-spacing: .3px;
  cursor: pointer;
}
.navbar nav { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
.navbar .btn-outline-light {
  border: 1px solid rgba(255,255,255,.5);
  color: #fff;
  background: transparent;
  padding: 6px 12px;
  border-radius: 6px;
  font-size: .85rem;
  font-weight: 500;
  cursor: pointer;
}
.navbar .btn-outline-light:hover { background: rgba(255,255,255,.15); }
.navbar .btn-light {
  background: #fff;
  color: var(--primary);
  border: none;
  padding: 6px 12px;
  border-radius: 6px;
  font-size: .85rem;
  font-weight: 600;
  cursor: pointer;
}
.navbar .btn-light:hover { background: #f3f4f6; }
.navbar .user {
  color: #fff;
  font-size: .85rem;
  margin-right: 8px;
}

/* ---------- Cards ---------- */
.card {
  background: #fff;
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 20px;
}
.card h3 { margin-top: 0; margin-bottom: 12px; }

/* ---------- Tiles ---------- */
.tile { cursor: pointer; transition: transform .15s, box-shadow .15s; }
.tile:hover { transform: translateY(-3px); box-shadow: var(--shadow-hover); }
.tile h4 { margin: 0 0 6px; font-size: 1.05rem; }
.tile p { color: var(--muted); font-size: .875rem; margin: 0; }

/* ---------- Buttons ---------- */
.btn {
  display: inline-block;
  padding: 8px 16px;
  border-radius: 8px;
  border: none;
  font-weight: 600;
  font-size: .9rem;
  cursor: pointer;
  transition: all .15s;
  text-align: center;
}
.btn-primary { background: var(--primary); color: #fff; }
.btn-primary:hover { background: var(--primary-dark); }
.btn-outline {
  background: transparent;
  border: 1px solid var(--border);
  color: var(--text);
}
.btn-outline:hover { border-color: var(--primary); color: var(--primary); }
.btn-success { background: var(--success); color: #fff; }
.btn-success:hover { background: #15803d; }
.btn-danger { background: var(--danger); color: #fff; }
.btn-danger:hover { background: #b91c1c; }
.btn-sm { padding: 5px 10px; font-size: .8rem; }
.btn-block { width: 100%; }
.btn:disabled { opacity: .5; cursor: not-allowed; }

/* ---------- Forms ---------- */
.form-group { margin-bottom: 14px; }
.form-group label {
  display: block;
  font-weight: 600;
  font-size: .875rem;
  margin-bottom: 6px;
}
.form-control, .form-select {
  width: 100%;
  padding: 9px 12px;
  border-radius: 8px;
  border: 1px solid var(--border);
  font-size: .95rem;
  font-family: inherit;
  transition: border-color .15s, box-shadow .15s;
}
.form-control:focus, .form-select:focus {
  outline: none;
  border-color: var(--primary);
  box-shadow: 0 0 0 3px rgba(79,70,229,.15);
}
.form-text { font-size: .8rem; color: var(--muted); }

/* ---------- Auth ---------- */
.auth-wrap {
  min-height: calc(100vh - 60px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px 16px;
}
.auth-card { width: 100%; max-width: 420px; }
.auth-card .card { padding: 28px; }

/* ---------- Alerts ---------- */
.alert {
  border-radius: 8px;
  padding: 12px 16px;
  font-size: .9rem;
  margin-bottom: 14px;
  border: none;
}
.alert-danger  { background: #fee2e2; color: #991b1b; }
.alert-success { background: #dcfce7; color: #166534; }
.alert-info    { background: #dbeafe; color: #1e40af; }
.alert-warning { background: #fef3c7; color: #92400e; }

/* ---------- Stats ---------- */
.stats-card { text-align: center; padding: 16px; }
.stats-card .stat-value {
  font-size: 1.9rem;
  font-weight: 700;
  color: var(--primary);
  line-height: 1.1;
}
.stats-card .stat-label {
  color: var(--muted);
  font-size: .72rem;
  text-transform: uppercase;
  letter-spacing: .5px;
  margin-top: 4px;
}

/* ---------- Question options ---------- */
.question-option {
  cursor: pointer;
  padding: 12px 16px;
  border: 1px solid var(--border);
  border-radius: 10px;
  margin-bottom: 8px;
  background: #fff;
  transition: all .15s;
  user-select: none;
}
.question-option:hover {
  background: var(--primary-light);
  border-color: var(--primary);
}
.question-option.selected {
  background: #e0e7ff;
  border-color: var(--primary);
  font-weight: 600;
}

/* ---------- Badges ---------- */
.badge {
  display: inline-block;
  font-size: .72rem;
  padding: 3px 9px;
  border-radius: 999px;
  font-weight: 600;
  background: #e5e7eb;
  color: #374151;
}
.badge-success { background: #dcfce7; color: #166534; }
.badge-danger  { background: #fee2e2; color: #991b1b; }
.badge-info    { background: #dbeafe; color: #1e40af; }

.ai-badge {
  display: inline-block;
  background: #ede9fe;
  color: #6d28d9;
  font-size: .7rem;
  font-weight: 700;
  letter-spacing: .3px;
  padding: 2px 8px;
  border-radius: 999px;
}

/* ---------- Difficulty ---------- */
.difficulty-EASY   { color: var(--success); font-weight: 700; font-size: .8rem; }
.difficulty-MEDIUM { color: var(--warning); font-weight: 700; font-size: .8rem; }
.difficulty-HARD   { color: var(--danger);  font-weight: 700; font-size: .8rem; }

/* ---------- Timer ---------- */
.timer {
  font-variant-numeric: tabular-nums;
  font-weight: 700;
  color: #fff;
  font-size: .95rem;
  padding: 6px 12px;
  border-radius: 8px;
  background: rgba(0,0,0,.35);
}
.timer.danger { background: var(--danger); animation: pulse 1s infinite; }
@keyframes pulse { 50% { opacity: .55; } }

/* ---------- Table ---------- */
.table { width: 100%; border-collapse: collapse; }
.table th, .table td {
  padding: 10px 12px;
  text-align: left;
  border-bottom: 1px solid var(--border);
  font-size: .9rem;
}
.table th {
  font-size: .75rem;
  text-transform: uppercase;
  letter-spacing: .4px;
  color: var(--muted);
}
.table tbody tr:hover { background: var(--primary-light); }

/* ---------- Misc ---------- */
.hidden { display: none !important; }
.text-muted { color: var(--muted); }
.text-center { text-align: center; }
.mt-1 { margin-top: 6px; }
.mt-2 { margin-top: 12px; }
.mt-3 { margin-top: 18px; }
.mt-4 { margin-top: 24px; }
.mb-1 { margin-bottom: 6px; }
.mb-2 { margin-bottom: 12px; }
.mb-3 { margin-bottom: 18px; }
.mb-4 { margin-bottom: 24px; }
.fw-bold { font-weight: 700; }
.small { font-size: .85rem; }
.flex { display: flex; }
.between { justify-content: space-between; }
.center { align-items: center; }
.gap-2 { gap: 12px; }
details summary {
  cursor: pointer;
  user-select: none;
  font-weight: 600;
  color: var(--primary);
}

/* ---------- Splash ---------- */
.splash {
  min-height: calc(100vh - 60px);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 24px;
}
.splash h1 { font-size: 2rem; margin-bottom: 12px; }
.splash p  { color: var(--muted); max-width: 520px; margin-bottom: 24px; }
</style>
</head>
<body>

<!-- Root mount point — all pages are rendered here -->
<div id="app"></div>

<script>
/* ============================================================
   AI Placement Preparation Platform — Single-File Frontend
   ------------------------------------------------------------
   A fully working, browser-only demo. State is kept in memory
   and persisted to localStorage so a refresh keeps you signed in.
   ============================================================ */

/* ------------------------------------------------------------
   1. "Database" — seeded question bank & users
   ------------------------------------------------------------ */
const DB = {
    users: [
        { userId: 1, name: "Admin",         email: "admin@placement.com",   password: "admin123",   role: "ADMIN"   },
        { userId: 2, name: "Demo Student",  email: "student@placement.com", password: "student123", role: "STUDENT" }
    ],
    categories: [
        { categoryId: 1, name: "Quantitative Aptitude", type: "APTITUDE"    },
        { categoryId: 2, name: "Logical Reasoning",     type: "APTITUDE"    },
        { categoryId: 3, name: "Verbal Ability",        type: "APTITUDE"    },
        { categoryId: 4, name: "Data Structures",       type: "PROGRAMMING" },
        { categoryId: 5, name: "Algorithms",            type: "PROGRAMMING" },
        { categoryId: 6, name: "DBMS",                  type: "PROGRAMMING" },
        { categoryId: 7, name: "Operating Systems",     type: "PROGRAMMING" },
        { categoryId: 8, name: "Java",                  type: "PROGRAMMING" }
    ],
    questions: [
        { questionId: 1,  categoryId: 1, text: "If 3x + 7 = 22, what is x?",
          optionA: "3", optionB: "5", optionC: "7", optionD: "9",
          correctOption: "B", difficulty: "EASY", explanation: "3x = 15, so x = 5." },
        { questionId: 2,  categoryId: 1, text: "A train travels 240 km in 4 hours. What is its average speed?",
          optionA: "40 km/h", optionB: "50 km/h", optionC: "60 km/h", optionD: "70 km/h",
          correctOption: "C", difficulty: "EASY", explanation: "Speed = Distance / Time = 240 / 4 = 60 km/h." },
        { questionId: 3,  categoryId: 1, text: "What is 25% of 480?",
          optionA: "100", optionB: "110", optionC: "120", optionD: "130",
          correctOption: "C", difficulty: "EASY", explanation: "0.25 × 480 = 120." },
        { questionId: 4,  categoryId: 1, text: "If a number is increased by 20% and then decreased by 20%, the net change is:",
          optionA: "+4%", optionB: "0%", optionC: "-4%", optionD: "-2%",
          correctOption: "C", difficulty: "MEDIUM", explanation: "1.2 × 0.8 = 0.96 → -4%." },
        { questionId: 5,  categoryId: 2, text: "Find the next number: 2, 6, 12, 20, ?",
          optionA: "28", optionB: "30", optionC: "32", optionD: "34",
          correctOption: "B", difficulty: "MEDIUM", explanation: "Differences are 4, 6, 8, 10 → 20 + 10 = 30." },
        { questionId: 6,  categoryId: 2, text: "If in a code, CAT = 3120, then DOG = ?",
          optionA: "4157", optionB: "4158", optionC: "4156", optionD: "4155",
          correctOption: "A", difficulty: "HARD", explanation: "C=3, A=1, T=20; D=4, O=15, G=7 → 4157." },
        { questionId: 7,  categoryId: 3, text: "Choose the synonym for 'abundant'.",
          optionA: "Scarce", optionB: "Plentiful", optionC: "Rare", optionD: "Meager",
          correctOption: "B", difficulty: "EASY", explanation: "Abundant = plentiful." },
        { questionId: 8,  categoryId: 3, text: "Identify the antonym of 'candid'.",
          optionA: "Frank", optionB: "Honest", optionC: "Evasive", optionD: "Open",
          correctOption: "C", difficulty: "MEDIUM", explanation: "Candid means open; the antonym is evasive." },
        { questionId: 9,  categoryId: 4, text: "Which data structure uses LIFO order?",
          optionA: "Queue", optionB: "Stack", optionC: "List", optionD: "Tree",
          correctOption: "B", difficulty: "EASY", explanation: "Stack = Last-In First-Out." },
        { questionId: 10, categoryId: 4, text: "Time complexity of inserting at the head of a singly linked list?",
          optionA: "O(1)", optionB: "O(log n)", optionC: "O(n)", optionD: "O(n log n)",
          correctOption: "A", difficulty: "MEDIUM", explanation: "Just adjust the head pointer — O(1)." },
        { questionId: 11, categoryId: 5, text: "Time complexity of binary search on a sorted array?",
          optionA: "O(n)", optionB: "O(log n)", optionC: "O(n log n)", optionD: "O(1)",
          correctOption: "B", difficulty: "MEDIUM", explanation: "Halves the search space each step." },
        { questionId: 12, categoryId: 5, text: "Which sorting algorithm has O(n²) worst-case and is stable?",
          optionA: "Quick Sort", optionB: "Heap Sort", optionC: "Insertion Sort", optionD: "Selection Sort",
          correctOption: "C", difficulty: "MEDIUM", explanation: "Insertion sort is O(n²) worst-case and stable." },
        { questionId: 13, categoryId: 6, text: "Which normal form eliminates transitive dependencies?",
          optionA: "1NF", optionB: "2NF", optionC: "3NF", optionD: "BCNF",
          correctOption: "C", difficulty: "MEDIUM", explanation: "3NF removes transitive dependencies." },
        { questionId: 14, categoryId: 6, text: "In SQL, which clause is used to filter groups?",
          optionA: "WHERE", optionB: "HAVING", optionC: "GROUP BY", optionD: "ORDER BY",
          correctOption: "B", difficulty: "EASY", explanation: "HAVING filters groups; WHERE filters rows." },
        { questionId: 15, categoryId: 7, text: "Which scheduling algorithm can cause starvation?",
          optionA: "Round Robin", optionB: "FCFS", optionC: "Priority Scheduling", optionD: "SJF (non-preemptive)",
          correctOption: "C", difficulty: "HARD", explanation: "Low-priority processes may never run." },
        { questionId: 16, categoryId: 8, text: "Which keyword prevents inheritance in Java?",
          optionA: "static", optionB: "final", optionC: "const", optionD: "private",
          correctOption: "B", difficulty: "EASY", explanation: "A final class cannot be extended." },
        { questionId: 17, categoryId: 8, text: "What is the size of an int in Java?",
          optionA: "2 bytes", optionB: "4 bytes", optionC: "8 bytes", optionD: "Depends on JVM",
          correctOption: "B", difficulty: "EASY", explanation: "Java int is always 32-bit (4 bytes)." },
        { questionId: 18, categoryId: 8, text: "Which collection allows duplicate elements?",
          optionA: "Set", optionB: "Map", optionC: "List", optionD: "None",
          correctOption: "C", difficulty: "EASY", explanation: "List allows duplicates; Set does not." }
    ],
    quizzes:       [],   // { quizId, userId, startedAt, submittedAt, status, timeLimitSeconds, questionIds }
    userAnswers:   [],   // { quizId, questionId, selected, isCorrect }
    quizResults:   [],   // { quizId, score, total, correct }
    aiHistory:     []    // { userId, type, prompt, response, createdAt }
};

const STORAGE_KEY = "ai_placement_state_v1";

/* ------------------------------------------------------------
   2. Persistence
   ------------------------------------------------------------ */
function persist() {
    try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify({
            users: DB.users,
            categories: DB.categories,
            questions: DB.questions,
            quizzes: DB.quizzes,
            userAnswers: DB.userAnswers,
            quizResults: DB.quizResults,
            aiHistory: DB.aiHistory,
            session: session
        }));
    } catch (e) {
        console.warn("persist failed", e);
    }
}

function restore() {
    try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return;
        const saved = JSON.parse(raw);
        Object.assign(DB, {
            users:       saved.users       ?? DB.users,
            categories:  saved.categories  ?? DB.categories,
            questions:   saved.questions   ?? DB.questions,
            quizzes:     saved.quizzes     ?? [],
            userAnswers: saved.userAnswers ?? [],
            quizResults: saved.quizResults ?? [],
            aiHistory:   saved.aiHistory   ?? []
        });
        if (saved.session) session = saved.session;
    } catch (e) {
        console.warn("restore failed", e);
    }
}

/* ------------------------------------------------------------
   3. Session
   ------------------------------------------------------------ */
let session = null;   // { userId, name, role }

function currentUser() {
    if (!session) return null;
    return DB.users.find(u => u.userId === session.userId) || null;
}

function logout() {
    session = null;
    persist();
    navigate("splash");
}

/* ------------------------------------------------------------
   4. Router
   ------------------------------------------------------------ */
let currentRoute = "splash";
let routeParams  = {};

function navigate(route, params = {}) {
    currentRoute = route;
    routeParams  = params;
    persist();
    render();
    window.scrollTo(0, 0);
}

/* ------------------------------------------------------------
   5. Helpers
   ------------------------------------------------------------ */
function escapeHtml(s) {
    if (s == null) return "";
    return String(s)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
}

function formatDate(value) {
    if (!value) return "—";
    const d = new Date(value);
    if (isNaN(d.getTime())) return "—";
    return d.toLocaleString(undefined, {
        year: "numeric", month: "short", day: "numeric",
        hour: "2-digit", minute: "2-digit"
    });
}

function categoryById(id) {
    return DB.categories.find(c => c.categoryId === id);
}

function uid() {
    return Date.now() + Math.floor(Math.random() * 1000);
}

function shuffle(arr) {
    const a = [...arr];
    for (let i = a.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
}

/* ------------------------------------------------------------
   6. AI Engine (simulated locally, no network)
   ------------------------------------------------------------ */
const AI = {
    /**
     * Generate an explanation for a wrong answer.
     * Returns { mistake, correctAnswer, steps, tip }.
     */
    explain(question, selectedOption) {
        const correct = question.correctOption;
        const correctText = question["option" + correct];
        const selectedText = selectedOption
            ? question["option" + selectedOption]
            : null;

        const mistake = selectedText
            ? `You chose "${selectedText}" (option ${selectedOption}), but the correct option is ${correct}.`
            : `You did not answer this question. The correct option is ${correct}.`;

        const steps = [
            `Read the question carefully: "${question.text}"`,
            `Identify what is being asked and the rule or formula that applies.`,
            `Work out the answer step by step — for this question, the correct value is "${correctText}".`,
            `Compare your working with the options and select the one that matches.`
        ];

        const tip = `Tip: ${question.explanation} Practice more "${categoryById(question.categoryId)?.name}" questions to reinforce this pattern.`;

        return {
            mistake,
            correctAnswer: `${correct}. ${correctText}`,
            steps,
            tip
        };
    },

    /**
     * Analyse the student's accuracy per category and return the weakest ones.
     */
    weakCategories(userId) {
        const answers = DB.userAnswers.filter(a => {
            const q = DB.quizzes.find(x => x.quizId === a.quizId);
            return q && q.userId === userId;
        });

        const byCat = {};
        answers.forEach(a => {
            const q = DB.questions.find(x => x.questionId === a.questionId);
            if (!q) return;
            const cat = q.categoryId;
            byCat[cat] = byCat[cat] || { total: 0, correct: 0 };
            byCat[cat].total++;
            if (a.isCorrect) byCat[cat].correct++;
        });

        return Object.entries(byCat)
            .map(([catId, s]) => ({
                categoryId: Number(catId),
                accuracy: s.correct / s.total,
                total: s.total
            }))
            .filter(s => s.accuracy < 0.6)
            .sort((a, b) => a.accuracy - b.accuracy)
            .map(s => s.categoryId);
    },

    /**
     * Generate `count` personalized questions for a student's weak topics.
     * Uses hand-crafted templates to look like real generated MCQs.
     */
    generateQuestions(userId, count = 5) {
        const weak = this.weakCategories(userId);
        const fallback = DB.categories
            .filter(c => c.type === "APTITUDE" || c.type === "PROGRAMMING")
            .map(c => c.categoryId);

        const targetCats = (weak.length ? weak : fallback).slice(0, 3);

        const templates = {
            1: [ // Quantitative Aptitude
                { q: "What is 15% of 240?", a: "30", b: "36", c: "40", d: "44", ans: "B", exp: "0.15 × 240 = 36." },
                { q: "If 5x − 3 = 22, what is x?", a: "3", b: "4", c: "5", d: "6", ans: "C", exp: "5x = 25 → x = 5." },
                { q: "A sum doubles in 8 years at simple interest. Rate?", a: "10%", b: "12.5%", c: "15%", d: "8%", ans: "B", exp: "100/P × 8 = 100 → 12.5%." }
            ],
            2: [ // Logical Reasoning
                { q: "Next in series: 3, 9, 27, 81, ?", a: "162", b: "243", c: "216", d: "324", ans: "B", exp: "Multiply by 3 → 243." },
                { q: "If A > B and B > C, then:", a: "A < C", b: "A = C", c: "A > C", d: "Cannot say", ans: "C", exp: "Transitive: A > C." }
            ],
            3: [ // Verbal
                { q: "Choose the synonym for 'lucid'.", a: "Confusing", b: "Clear", c: "Dark", d: "Heavy", ans: "B", exp: "Lucid = clear." },
                { q: "Antonym of 'frugal'.", a: "Thrifty", b: "Extravagant", c: "Careful", d: "Simple", ans: "B", exp: "Frugal ↔ extravagant." }
            ],
            4: [ // Data Structures
                { q: "Which structure uses FIFO?", a: "Stack", b: "Queue", c: "Tree", d: "Graph", ans: "B", exp: "Queue = First-In First-Out." },
                { q: "Hash table average lookup time?", a: "O(1)", b: "O(log n)", c: "O(n)", d: "O(n²)", ans: "A", exp: "Average O(1)." }
            ],
            5: [ // Algorithms
                { q: "Which sort is fastest on nearly-sorted data?", a: "Quick", b: "Insertion", c: "Merge", d: "Heap", ans: "B", exp: "Insertion is O(n) on nearly-sorted data." },
                { q: "Time complexity of merge sort?", a: "O(n)", b: "O(log n)", c: "O(n log n)", d: "O(n²)", ans: "C", exp: "Merge sort is O(n log n) always." }
            ],
            6: [ // DBMS
                { q: "Which key uniquely identifies a row?", a: "Foreign key", b: "Primary key", c: "Candidate key", d: "Composite key", ans: "B", exp: "Primary key uniquely identifies a row." },
                { q: "SQL command to remove a table?", a: "DELETE", b: "DROP", c: "TRUNCATE", d: "REMOVE", ans: "B", exp: "DROP TABLE removes structure and data." }
            ],
            7: [ // OS
                { q: "Which is not a scheduling algorithm?", a: "FCFS", b: "SJF", c: "LRU", d: "Round Robin", ans: "C", exp: "LRU is a page replacement policy." },
                { q: "Deadlock requires all of the following EXCEPT:", a: "Mutual exclusion", b: "Hold and wait", c: "Preemption", d: "Circular wait", ans: "C", exp: "Deadlock needs no preemption, not preemption." }
            ],
            8: [ // Java
                { q: "Which is not a primitive type in Java?", a: "int", b: "boolean", c: "String", d: "char", ans: "C", exp: "String is a class, not a primitive." },
                { q: "Keyword to inherit a class in Java?", a: "implements", b: "extends", c: "inherits", d: "super", ans: "B", exp: "extends inherits a class." }
            ]
        };

        const result = [];
        const difficulties = ["EASY", "MEDIUM", "HARD"];

        let pool = [];
        targetCats.forEach(catId => {
            const items = templates[catId] || [];
            items.forEach(t => pool.push({ ...t, categoryId: catId }));
        });

        // If we still don't have enough, pull from any template
        if (pool.length < count) {
            Object.entries(templates).forEach(([catId, items]) => {
                items.forEach(t => pool.push({ ...t, categoryId: Number(catId) }));
            });
        }

        pool = shuffle(pool).slice(0, count);

        pool.forEach((t, i) => {
            result.push({
                questionId: -1 - i,          // temporary; not persisted
                categoryId: t.categoryId,
                text: t.q,
                optionA: t.a, optionB: t.b, optionC: t.c, optionD: t.d,
                correctOption: t.ans,
                difficulty: difficulties[Math.floor(Math.random() * 3)],
                explanation: t.exp,
                aiGenerated: true
            });
        });

        // If we somehow still have fewer than count, pad with random pool
        while (result.length < count) {
            const q = DB.questions[Math.floor(Math.random() * DB.questions.length)];
            result.push({
                ...q,
                questionId: -100 - result.length,
                aiGenerated: true
            });
        }

        // Log to AI history
        DB.aiHistory.push({
            userId,
            type: "GENERATE",
            prompt: `Weak categories: ${targetCats.join(", ")}`,
            response: `${result.length} questions generated`,
            createdAt: new Date().toISOString()
        });
        persist();

        return result;
    },

    logExplain(userId, questionId, selectedOption, response) {
        DB.aiHistory.push({
            userId,
            type: "EXPLAIN",
            prompt: `Question #${questionId}, selected ${selectedOption}`,
            response: JSON.stringify(response).slice(0, 500),
            createdAt: new Date().toISOString()
        });
        persist();
    }
};

