function createCategory() {
    const name = document.getElementById("newCatName").value.trim();
    const type = document.getElementById("newCatType").value;
    if (!name) { alert("Enter a name"); return; }
    if (DB.categories.some(c => c.name.toLowerCase() === name.toLowerCase())) {
        alert("Category already exists");
        return;
    }
    DB.categories.push({ categoryId: uid(), name, type });
    persist();
    render();
}

function deleteCategory(id) {
    const inUse = DB.questions.some(q => q.categoryId === id);
    if (inUse) {
        alert("Cannot delete: questions still reference this category.");
        return;
    }
    if (!confirm("Delete this category?")) return;
    const idx = DB.categories.findIndex(c => c.categoryId === id);
    if (idx >= 0) DB.categories.splice(idx, 1);
    persist();
    render();
}

