/* ------------------------------------------------------------
   8. Router render
   ------------------------------------------------------------ */
function render() {
    const app = document.getElementById("app");
    let html = "";
    let after = null;

    switch (currentRoute) {
        case "splash":             html = viewSplash();            break;
        case "login":              html = viewLogin();    after = afterLoginRender;    break;
        case "register":           html = viewRegister(); after = afterRegisterRender; break;
        case "student-dashboard":  html = viewStudentDashboard();  break;
        case "practice":           html = viewPractice();          break;
        case "quiz-setup":         html = viewQuizSetup();         break;
        case "quiz":               html = viewQuiz();      after = afterQuizRender;    break;
        case "result":             html = viewResult();            break;
        case "history":            html = viewHistory();           break;
        case "ai-assistant":       html = viewAiAssistant();       break;
        case "admin-dashboard":    html = viewAdminDashboard();    break;
        case "admin-questions":    html = viewAdminQuestions();    break;
        case "admin-categories":   html = viewAdminCategories();   break;
        case "admin-students":     html = viewAdminStudents();     break;
        default:                   html = viewSplash();
    }

    app.innerHTML = html;
    if (typeof after === "function") after();
}

