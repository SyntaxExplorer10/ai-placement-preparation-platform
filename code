function createQuestion() {
    const catId  = Number(document.getElementById("newCat").value);
    const diff   = document.getElementById("newDiff").value;
    const correct = document.getElementById("newCorrect").value;
    const text   = document.getElementById("newText").value.trim();
    const a = document.getElementById("newA").value.trim();
    const b = document.getElementById("newB").value.trim();
    const c = document.getElementById("newC").value.trim();
    const d = document.getElementById("newD").value.trim();
    const exp = document.getElementById("newExp").value.trim();

    if (!text || !a || !b || !c || !d) {
        alert("Please fill in the question and all four options.");
        return;
    }

    DB.questions.push({
        questionId: uid(),
        categoryId: catId,
        text,
        optionA: a, optionB: b, optionC: c, optionD: d,
        correctOption: correct,
        difficulty: diff,
        explanation: exp
    });
    persist();
    render();
}

function deleteQuestion(id) {
    if (!confirm("Delete this question?")) return;
    const idx = DB.questions.findIndex(q => q.questionId === id);
    if (idx >= 0) DB.questions.splice(idx, 1);
    persist();
    render();
}

